{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @nextgen/db run build && pnpm run build",
  "regions": [
    "gru1"
  ],
  "crons": [
    {
      "path": "/api/cron/cobrancas",
      "schedule": "0 11 * * *"
    }
  ]
}
