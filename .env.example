# ── Banco ─────────────────────────────────────────────────────────────
# Dono das tabelas: só migrações e seed. Nunca use esta URL na aplicação.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nextgen"
# Papel de aplicação: NOSUPERUSER NOBYPASSRLS. É o que faz a RLS valer.
APP_DATABASE_URL="postgresql://nextgen_app:app@localhost:5432/nextgen"

# ── Sessão ────────────────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET="troque-este-valor"
BETTER_AUTH_URL="http://localhost:3000"

# ── Storage (Vercel Blob) ─────────────────────────────────────────────
# Store público: material de vitrine e card do aluno.
BLOB_PUBLIC_READ_WRITE_TOKEN=""
# Store privado: prontuário, anamnese, vídeo de treino.
BLOB_PRIVATE_READ_WRITE_TOKEN=""

# ── E-mail ────────────────────────────────────────────────────────────
# Duas opções. SMTP tem precedência sobre Resend quando ambos estão preenchidos.
#
# 1) SMTP (Gmail). EMAIL_PASS precisa ser SENHA DE APP do Google, não a senha da
#    conta: com 2FA ligado, o Gmail recusa login SMTP comum com "535-5.7.8".
#    Gmail: 500 destinatários/dia. Serve para piloto, não para escala.
EMAIL_USER=""
EMAIL_PASS=""
# Padrões: host smtp.gmail.com quando EMAIL_USER termina em @gmail.com; porta 465
# (TLS implícito). Para 587, defina EMAIL_PORT=587.
# EMAIL_HOST=""
# EMAIL_PORT=""
#
# 2) Resend (API HTTP, melhor entrega em produção)
RESEND_API_KEY=""
# Se vazio em SMTP, o From vira "NextGen <EMAIL_USER>" — o Gmail reescreve remetente
# de domínio não verificado de qualquer forma.
MAIL_FROM=""
# Só para ambientes que não são produção na Vercel. Ignorado quando VERCEL_ENV=production.
# MAIL_TRANSPORT="console"

# ── Deploy ────────────────────────────────────────────────────────────
# Origens extras aceitas pelo Better Auth (previews, domínio antigo). Separadas por vírgula.
# BETTER_AUTH_TRUSTED_ORIGINS="https://nextgen-git-main-suaorg.vercel.app"

# ── Asaas (assinatura da NextGen) ─────────────────────────────────────
# Cobra a escola pelo uso do produto. NÃO é a mensalidade do aluno: aquela é Pix na
# conta da própria escola (doc 07). Sandbox: https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=""
# ASAAS_BASE_URL="https://sandbox.asaas.com/api/v3"
# Token do webhook, configurado no painel do Asaas e conferido em /api/webhooks/asaas.
ASAAS_WEBHOOK_TOKEN=""

# ── Job diário do envio de cobrança ───────────────────────────────────
# Header esperado: Authorization: Bearer $CRON_SECRET. Sem ele, a rota responde 401.
# openssl rand -base64 32
CRON_SECRET=""

# ── Integrações previstas para as próximas fases ──────────────────────
INNGEST_EVENT_KEY=""

# Quem opera o SaaS. Lista separada por vírgula; vazio = ninguém.
# O login grava a marca em users.is_platform_staff, que é o que a RLS consulta.
PLATFORM_ADMIN_EMAILS=""
