# ── Banco ─────────────────────────────────────────────────────────────
# Dono das tabelas: só migrações e seed. Nunca use esta URL na aplicação.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nextgen"
# Papel de aplicação: NOSUPERUSER NOBYPASSRLS. É o que faz a RLS valer.
APP_DATABASE_URL="postgresql://nextgen_app:app@localhost:5432/nextgen"

# ── Sessão ────────────────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET="troque-este-valor"
BETTER_AUTH_URL="http://localhost:3000"

# ── Storage (Vercel Blob) ─────────────────────────────────────────────
# Store público: material de vitrine e card do aluno.
BLOB_PUBLIC_READ_WRITE_TOKEN=""
# Store privado: prontuário, anamnese, vídeo de treino.
BLOB_PRIVATE_READ_WRITE_TOKEN=""

# ── Integrações previstas para as próximas fases ──────────────────────
RESEND_API_KEY=""
ASAAS_API_KEY=""
INNGEST_EVENT_KEY=""
