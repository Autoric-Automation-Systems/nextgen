# ── Banco ─────────────────────────────────────────────────────────────
# Dono das tabelas: só migrações e seed. Nunca use esta URL na aplicação.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nextgen"
# Papel de aplicação: NOSUPERUSER NOBYPASSRLS. É o que faz a RLS valer.
APP_DATABASE_URL="postgresql://nextgen_app:app@localhost:5432/nextgen"

# ── Sessão ────────────────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET="troque-este-valor"
BETTER_AUTH_URL="http://localhost:3000"

# ── Storage (Vercel Blob) ─────────────────────────────────────────────
# Store público: material de vitrine e card do aluno.
BLOB_PUBLIC_READ_WRITE_TOKEN=""
# Store privado: prontuário, anamnese, vídeo de treino.
BLOB_PRIVATE_READ_WRITE_TOKEN=""

# ── E-mail ────────────────────────────────────────────────────────────
# Em produção, sem RESEND_API_KEY + MAIL_FROM o link mágico NÃO é enviado:
# o console seria um vazamento (quem lê o log entra na conta de qualquer um).
RESEND_API_KEY=""
MAIL_FROM="NextGen <nao-responda@seudominio.com.br>"
# Só para ambientes que não são produção na Vercel. Ignorado quando VERCEL_ENV=production.
# MAIL_TRANSPORT="console"

# ── Deploy ────────────────────────────────────────────────────────────
# Origens extras aceitas pelo Better Auth (previews, domínio antigo). Separadas por vírgula.
# BETTER_AUTH_TRUSTED_ORIGINS="https://nextgen-git-main-suaorg.vercel.app"

# ── Integrações previstas para as próximas fases ──────────────────────
ASAAS_API_KEY=""
INNGEST_EVENT_KEY=""
