{
  "name": "nextgen",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @nextgen/db generate",
    "db:migrate": "pnpm --filter @nextgen/db migrate",
    "db:seed": "pnpm --filter @nextgen/db seed",
    "db:seed:demo": "pnpm --filter @nextgen/db seed:demo"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp"
    ]
  }
}
